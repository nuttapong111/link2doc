{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile", "watchPatterns": ["cmd/**", "internal/**", "pkg/**", "web/**", "go.mod", "go.sum", "Dockerfile"] },
  "deploy": { "healthcheckPath": "/healthz", "healthcheckTimeout": 120, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 5 }
}
