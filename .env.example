# ---- Required ----
APP_URL=https://link2doc-production.up.railway.app   # public URL of the web service, no trailing slash
DATABASE_URL=${{Postgres.DATABASE_URL}}               # Railway reference variable
SESSION_SECRET=                                       # openssl rand -hex 32
ENCRYPTION_KEY=                                       # openssl rand -hex 32 (keep it; changing it logs everyone out of Google/Dify)

# ---- Public mode: customers use the converter without signing in ----
PUBLIC_MODE=true
ADMIN_USERNAME=admin              # admin signs in with this at /#/login, then connects the company Google Drive in Settings
ADMIN_PASSWORD=                   # long random password
# GUEST_MAX_LINKS=20              # max links/files per job for customers
# GUEST_JOBS_PER_HOUR=20

# ---- Google OAuth client (used once by the admin to connect the company Drive) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=company.co.th      # only these email domains can sign in (comma-separated)
GOOGLE_DRIVE_SCOPE=full           # full = paste any folder/Doc link (fine for Internal apps); file = drive.file + Picker
# GOOGLE_API_KEY=                 # optional, enables "เลือกจาก Drive" (Google Picker)
# GOOGLE_APP_ID=                  # Cloud project number, needed with GOOGLE_API_KEY

# ---- PDF ----
PDF_WORKER_URL=http://${{pdf-worker.RAILWAY_PRIVATE_DOMAIN}}:8000   # set PORT=8000 on pdf-worker
PDF_WORKER_TOKEN=                 # same random value here and on pdf-worker

# ---- Optional ----
# MODE=all                        # all (default) | api | worker  — split into two services when traffic grows
# FETCH_CONCURRENCY=4
# PER_DOMAIN_DELAY_MS=1000
# MAX_LINKS_PER_JOB=100
# SCHEDULE_TZ=Asia/Bangkok
# ALLOWED_EMAILS=a@company.co.th,b@company.co.th
# DEV_LOGIN=true                  # local http only: /auth/dev signs in without Google
# ALLOW_PRIVATE_FETCH=true        # local testing only: allow fetching localhost
